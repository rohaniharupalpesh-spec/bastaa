# Password for the admin dashboard (required)
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions: e.g. `openssl rand -hex 32`
SESSION_SECRET=
PORT=3000
# Where the SQLite database is stored
DATABASE_FILE=./data/stock.db
# Comma-separated website origins allowed to call the API from the browser (* = any)
ALLOWED_ORIGINS=*
# Set to true when served over HTTPS (recommended in production)
SECURE_COOKIES=false
# Set to true when running behind a reverse proxy (nginx, Render, Railway, ...)
TRUST_PROXY=false
